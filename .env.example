# ==============================================================================
# Gadzio Storefront & Store Admin — Environment Variable Template
# ==============================================================================
# Copy this file to `.env.local` for local development or configure these names
# in Vercel Project Settings (Environment Variables) scoped to Production /
# Preview (Staging). Never commit real keys, salts, tokens, or connection
# strings. Run `npm run check:production-env` to verify safety rules before
# deploying.

# ------------------------------------------------------------------------------
# 1. REQUIRED IN PRODUCTION (APP_ENV=production)
# ------------------------------------------------------------------------------

# Deployment environment guard: must be "production" on prod or "staging" on staging.
APP_ENV=production

# Public HTTPS origin ONLY (no trailing slash, path, query, or hash).
# Never localhost and never a temporary tunnel host (*.trycloudflare.com, ngrok, etc.).
APP_BASE_URL=https://store.example.com

# Supabase PostgreSQL Transaction Pooler URL on port 6543 (with SSL enabled).
# Used by Next.js server routes at runtime (pipelining is disabled automatically on 6543).
DATABASE_URL=postgresql://postgres.your_project_ref:your_db_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase project URL and keys (Server-side routes also use Supabase Storage via service role).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PayU LIVE gateway settings (APP_ENV=production requires PAYU_ENV=live and secure.payu.in).
PAYU_ENV=live
PAYU_BASE_URL=https://secure.payu.in/_payment
PAYU_KEY=your-live-payu-merchant-key
PAYU_SALT=your-live-payu-merchant-salt

# HMAC secret for short-lived PayU return links (minimum 32 characters, random).
PAYU_RETURN_SECRET=replace-with-random-secret-at-least-32-chars

# Shared Bearer token protecting /api/payu/reconcile (minimum 32 characters, random).
CRON_SECRET=replace-with-random-secret-at-least-32-chars

# Must be "1" when deployed behind Vercel's reverse proxy so per-IP rate limiting reads client IPs safely.
TRUST_PROXY=1

# Required when Store Admin email sending is turned ON (mail_status=on).
# MAIL_PASSWORD holds the SMTP / Resend password; MAIL_ALLOWED_HOSTS locks down the SMTP hostname.
MAIL_PASSWORD=replace-with-smtp-or-resend-password
MAIL_ALLOWED_HOSTS=smtp.resend.com

# ------------------------------------------------------------------------------
# 2. REQUIRED FOR STAGING (APP_ENV=staging)
# ------------------------------------------------------------------------------
# Use a separate Supabase staging project and PayU TEST credentials. Never share
# PAYU_RETURN_SECRET or CRON_SECRET across staging and production.
#
# APP_ENV=staging
# APP_BASE_URL=https://staging.example.com
# DATABASE_URL=postgresql://postgres.staging_ref:staging_db_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
# NEXT_PUBLIC_SUPABASE_URL=https://your-staging-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-staging-supabase-publishable-key
# SUPABASE_SERVICE_ROLE_KEY=your-staging-supabase-service-role-key
# PAYU_ENV=test
# PAYU_BASE_URL=https://test.payu.in/_payment
# PAYU_KEY=your-test-payu-merchant-key
# PAYU_SALT=your-test-payu-merchant-salt
# PAYU_RETURN_SECRET=replace-with-distinct-staging-secret-at-least-32-chars
# CRON_SECRET=replace-with-distinct-staging-cron-secret-at-least-32-chars
# TRUST_PROXY=1
# MAIL_ALLOWED_HOSTS=smtp.resend.com
# MAIL_PASSWORD=replace-with-staging-smtp-password

# ------------------------------------------------------------------------------
# 3. OPTIONAL (CLI Migrations, SMS, Data Migration, Tuning)
# ------------------------------------------------------------------------------

# Direct/Session Pooler URL on port 5432 for `npm run db:migrate` and CLI scripts ONLY.
# NOT required at Vercel runtime and intentionally rejected on port 6543 by scripts/migrate.mjs.
# DATABASE_MIGRATION_URL=postgresql://postgres.your_project_ref:your_db_password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# TLS toggle for PostgreSQL connections (set to "false" ONLY for local non-TLS Postgres).
# DATABASE_SSL=true

# Per-process postgres.js pool ceiling (recommended 5 on serverless).
# DATABASE_POOL_MAX=5

# Emergency override only: keep unset so port 6543 disables pipelining automatically.
# DATABASE_DISABLE_POOLER_NO_PIPELINE=

# SMS delivery secrets (required only if SMS provider and SMS sending are enabled in Store Admin).
# MSG91_AUTH_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# Optional notification history retention scrubbing during /api/payu/reconcile ticks.
# NOTIFICATION_RETENTION_ENABLED=false
# NOTIFICATION_RETENTION_DAYS=90

# Feature flag for deferred Education Store routes (leave unset in normal storefront deployments).
# NEXT_PUBLIC_ENABLE_EDUCATION_STORE=

# CLI data-migration script credentials only (never set in Vercel runtime).
# SOURCE_DATABASE_URL=
# TARGET_DATABASE_URL=
